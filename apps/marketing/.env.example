VITE_SITE_URL=https://journeyhome.ng

# Server-only environment variables (Nitro SSR)
API_BASE_URL=http://localhost:4000/api/v1
USE_MOCKS=false
# Leave empty for default (on in dev, off in production). true/false to force.
